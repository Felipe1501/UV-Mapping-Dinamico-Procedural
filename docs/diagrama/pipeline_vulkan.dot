// Arquitetura do pipeline Vulkan - UV Mapping Dinâmico e Procedural
// Reflete a implementação em código/src/VulkanApp.cpp.
// Gerar: dot -Tpdf pipeline_vulkan.dot -o pipeline_vulkan.pdf
//
// Cores dos nós: azul = dados e recursos; verde = estágios e shaders;
// laranja = sincronização; roxo = render pass e attachments;
// amarelo = operações de UV mapping.
// Setas: contínuas = fluxo de dados; tracejadas laranja = sincronização.

digraph VulkanPipeline {

    graph [
        rankdir=TB,
        splines=spline,
        nodesep=0.12,
        ranksep=0.30,
        pad=0.15,
        bgcolor="white",
        fontname="Arial",
        fontsize=16,
        newrank=true,
        compound=true
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=13,
        margin="0.10,0.06"
    ];

    edge [
        fontname="Arial",
        fontsize=11,
        color="#333333",
        arrowsize=0.7
    ];

    // ---------------- Aplicação (CPU) ----------------
    subgraph cluster_cpu {
        label="Aplicação (CPU)"; style="rounded,dashed"; color="#777777";

        app [label="Aplicação\nrelógio (std::chrono)\nteclas 1 a 5 (modo)", fillcolor="#D9EAF7"];
        vbuf [label="Vertex Buffer\nDEVICE_LOCAL, stride 32 B\npos (0) · normal (12) · uv (24)", fillcolor="#D9EAF7"];
        ibuf [label="Index Buffer\nDEVICE_LOCAL, UINT32\n12.636 índices", fillcolor="#D9EAF7"];
        ubo  [label="Uniform Buffer (1 por imagem)\nM, V, P · time · mode\n208 B, std140, mapeado", fillcolor="#D9EAF7"];
        staging [label="Staging buffers\n(cópia única)", fillcolor="#D9EAF7"];
    }

    // ---------------- Textura ----------------
    subgraph cluster_tex {
        label="Textura"; style="rounded,dashed"; color="#777777";

        teximg [label="VkImage\nR8G8B8A8_SRGB\n512×512, 1 nível", fillcolor="#D9EAF7"];
        texview [label="VkImageView", fillcolor="#D9EAF7"];
        sampler [label="VkSampler\nLINEAR · REPEAT\nanisotropia", fillcolor="#D9EAF7"];
    }

    // ---------------- Sincronização ----------------
    subgraph cluster_sync {
        label="Sincronização"; style="rounded,dashed"; color="#C47A00";

        bar1 [label="Barreira 1\nUNDEFINED → TRANSFER_DST\nTOP_OF_PIPE → TRANSFER", fillcolor="#F9E2B8", color="#C47A00"];
        bar2 [label="Barreira 2\nTRANSFER_DST → SHADER_READ_ONLY\nTRANSFER → FRAGMENT_SHADER", fillcolor="#F9E2B8", color="#C47A00"];
        fences [label="Fences e semáforos\n2 quadros em execução\nimagesInFlight (por imagem)\nimageAvailable · renderFinished", fillcolor="#F9E2B8", color="#C47A00"];
        subdep [label="Dependência do subpass\nEXTERNAL → Subpass 0\nCOLOR_ATTACHMENT_OUTPUT +\ntestes de fragmento", fillcolor="#F9E2B8", color="#C47A00"];
    }

    // ---------------- Descriptor set ----------------
    subgraph cluster_desc {
        label="Descriptor Set 0"; style="rounded,dashed"; color="#777777";

        desc [label="binding 0: UNIFORM_BUFFER\n(vertex + fragment)\n\nbinding 1: COMBINED_IMAGE_SAMPLER\n(fragment)", fillcolor="#E4D9F7"];
    }

    // ---------------- Pipeline gráfico ----------------
    subgraph cluster_pipe {
        label="Pipeline gráfico"; style="rounded,dashed"; color="#4C8C4A";

        vin  [label="Vertex Input", fillcolor="#DCEFD8"];
        vs   [label="Vertex Shader\ngl_Position = P·V·M·p\nrepassa UV e normal", fillcolor="#CDE8C9"];
        rast [label="Rasterização\n+ interpolação\n(correção de perspectiva)", fillcolor="#CDE8C9"];
        fs   [label="Fragment Shader\nescolhe o modo (1 a 5)\n+ iluminação difusa", fillcolor="#BFE0BA"];

        dyn  [label="UV dinâmico\nu' = u + 0,10·t\n+ ondulação", fillcolor="#FFF2CC", color="#B7950B"];
        proc [label="Procedural\nC = f(UV, t)\n3 senoides", fillcolor="#FFF2CC", color="#B7950B"];
    }

    // ---------------- Render pass ----------------
    subgraph cluster_rp {
        label="Render Pass (Subpass 0)"; style="rounded,dashed"; color="#7A4E9A";

        color_att [label="Color attachment\nCLEAR / STORE\nUNDEFINED → COLOR_ATTACHMENT_OPTIMAL\n→ PRESENT_SRC_KHR", fillcolor="#E8D9F0"];
        depth_att [label="Depth attachment\nD32_SFLOAT · CLEAR / DONT_CARE\nUNDEFINED →\nDEPTH_STENCIL_ATTACHMENT_OPTIMAL", fillcolor="#E8D9F0"];
        fb [label="Framebuffer\n(1 por imagem)", fillcolor="#DCC8E8"];
    }

    present [label="Swapchain\napresentação", fillcolor="#D9EAF7"];

    // ---------------- Fluxo de dados ----------------
    app -> ubo [label="time, mode, M, V, P\n(memcpy por quadro)"];
    staging -> vbuf [label="vkCmdCopyBuffer"];
    staging -> ibuf;
    staging -> teximg [label="vkCmdCopyBufferToImage"];

    vbuf -> vin [label="atributos"];
    ibuf -> vin [label="índices"];
    vin -> vs;
    vs -> rast [label="posição + UV"];
    rast -> fs [label="fragUV, fragNormal"];
    fs -> dyn [dir=both, label="modos 2 e 4"];
    fs -> proc [dir=both, label="modos 3 e 4"];
    fs -> color_att [label="outColor"];
    rast -> depth_att [label="teste de\nprofundidade"];
    color_att -> fb;
    depth_att -> fb;
    fb -> present;

    ubo -> desc [label="binding 0"];
    teximg -> texview;
    texview -> desc [label="binding 1"];
    sampler -> desc [label="binding 1"];
    desc -> vs [label="UBO"];
    desc -> fs [label="UBO + textura"];

    // ---------------- Sincronização ----------------
    teximg -> bar1 [style=dashed, color="#C47A00"];
    bar1 -> bar2 [style=dashed, color="#C47A00", label="após a cópia"];
    bar2 -> fs [style=dashed, color="#C47A00", label="textura pronta"];
    fences -> ubo [style=dashed, color="#C47A00", label="libera a escrita"];
    fences -> present [style=dashed, color="#C47A00", label="renderFinished"];
    subdep -> color_att [style=dashed, color="#C47A00", label="espera o quadro anterior"];
    subdep -> depth_att [style=dashed, color="#C47A00"];
}
